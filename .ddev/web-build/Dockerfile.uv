# Project-owned file (not generated by DDEV).
# uv + Python 3.15, the version the Docker image ships (DDEV's web image has an older python).
ENV UV_UNMANAGED_INSTALL=/usr/local/bin \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PROJECT_ENVIRONMENT=/var/tmp/skoda-mate-venv \
    UV_LINK_MODE=copy
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && uv python install 3.15 \
    && chmod -R a+rX /opt/uv-python
